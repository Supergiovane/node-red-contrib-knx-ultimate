{
  "name": "node-red-contrib-knx-ultimate",
  "engines": {
    "node": ">=20.18.1"
  },
  "version": "8.0.1-beta.0",
  "description": "KNX integration for Node-RED with KNX/IP and KNX Secure, ETS import, routing, diagnostics, automation utilities, MQTT and Modbus adapters. Optional Hue Ultimate and Matter Ultimate packages connect through the KNX gateway.",
  "files": [
    "nodes/",
    "resources/",
    "examples/",
    "img/logo-big.png",
    "img/readmemain.png",
    "docs/assets/brand/made-in-italy.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "MIGRATION.md",
    "scripts/check-legacy-flows.js"
  ],
  "dependencies": {
    "knxultimate": "6.0.6",
    "lodash": "4.18.1",
    "mqtt": "^5.15.2",
    "ping": "0.4.4",
    "winston": "^3.17.0"
  },
  "node-red": {
    "version": ">=3.1.1",
    "plugins": {
      "commonFunctions": "/nodes/commonFunctions.js",
      "knxUltimateFlowBubbles": "/nodes/plugins/knxUltimate-flow-bubbles-plugin.html",
      "knxUltimateV8MigrationRecovery": "/nodes/plugins/knxUltimate-v8-migration-recovery-plugin.html"
    },
    "nodes": {
      "knxUltimate": "/nodes/knxUltimate.js",
      "knxUltimateUtility": "/nodes/knxUltimateUtility.js",
      "knxUltimateViewer": "/nodes/knxUltimateViewer.js",
      "knxUltimateMultiRouting": "/nodes/knxUltimateMultiRouting.js",
      "knxUltimateRouterFilter": "/nodes/knxUltimateRouterFilter.js",
      "knxUltimateIoTBridge": "/nodes/knxUltimateIoTBridge.js",
      "knxUltimateLegacyMigration": "/nodes/knxUltimateLegacyMigration.js",
      "knxUltimate-config": "/nodes/knxUltimate-config.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Supergiovane/node-red-contrib-knx-ultimate.git"
  },
  "keywords": [
    "node-red",
    "node-red-contrib",
    "KNX",
    "knx-secure",
    "ETS",
    "eib",
    "konnex",
    "IOT",
    "mqtt",
    "modbus",
    "home-assistant",
    "building-automation",
    "home-automation",
    "smarthome",
    "routing"
  ],
  "author": {
    "name": "Massimo Saccani",
    "email": "maxsupergiovane@icloud.com",
    "url": "https://youtube.com/@maxsupervibe"
  },
  "license": "MIT",
  "publishConfig": {
    "tag": "beta",
    "access": "public"
  },
  "scripts": {
    "build": "npm run knx-viewer:build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "npm run knx-utility:check && npm run test:unit && node scripts/check-node-load.js",
    "test:unit": "mocha \"test/**/*.test.js\"",
    "release:publish": "node scripts/publish-and-refresh.js",
    "release:refresh-flows": "node scripts/publish-and-refresh.js --refresh-only",
    "avviaquesto-itest:knxbus": "node test/integration/knxLightTest.js",
    "lint:fix": "standard --fix",
    "lint-fix": "standard --fix",
    "knx-viewer:dev": "vite --config ui/knxUltimateViewer-vue/vite.config.mjs",
    "knx-viewer:build": "vite build --config ui/knxUltimateViewer-vue/vite.config.mjs",
    "translate-wiki": "node scripts/translate-wiki.js",
    "wiki:help-export": "node scripts/help-to-wiki.js",
    "wiki:validate": "node scripts/validate-wiki-languagebar.js",
    "wiki:fix-langbar": "node scripts/validate-wiki-languagebar.js --fix",
    "wiki:inject-header": "node scripts/inject-wiki-header.js",
    "wiki:menu-add": "node scripts/manage-wiki-menu.js",
    "wiki:help-migrate": "node scripts/migrate-node-help.js",
    "docs:sync": "node scripts/export-wiki-to-pages.js",
    "wiki:refresh": "npm run wiki:help-export && node scripts/generate-wiki-navbar.js && node scripts/prepare-wiki-pages.js && npm run docs:sync",
    "docs:prepare": "node scripts/generate-wiki-navbar.js && node scripts/prepare-docs.js",
    "docs:build": "npm run docs:prepare && jekyll build --source docs --destination docs/_site",
    "docs:serve": "npm run docs:prepare && jekyll serve --source docs --destination docs/_site --host 127.0.0.1",
    "docs:serve:norl": "npm run docs:serve",
    "knx-utility:generate": "node scripts/generate-knx-utility-profiles.js",
    "knx-utility:check": "node scripts/generate-knx-utility-profiles.js --check",
    "preinstall": "node scripts/check-legacy-flows.js"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "chai": "^4.3.10",
    "mocha": "^10.4.0",
    "vite": "^7.3.6",
    "vue": "^3.5.41",
    "marked": "^14.1.0",
    "js-yaml": "4.3.2"
  }
}
